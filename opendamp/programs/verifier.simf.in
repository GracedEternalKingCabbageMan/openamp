/* OpenDAMP verifier primary program P(pi).  TEMPLATE -- see src/programs.rs.
 *
 * This file is not compiled directly. `programs::render_verifier` substitutes
 * the tokens below to produce one program per SHAPE: a pair (N_max_inputs,
 * N_max_outputs) sized for a class of transfer. Every shape is a leaf of the
 * same C_V(pi) taptree, so the address does not depend on which one a spender
 * uses, and each asserts its own bounds, so a narrow leaf cannot be used for a
 * wide transaction.
 *
 * Why shapes rather than one program. Simplicity's cost bound is STATIC: it
 * covers the whole program DAG and does not shrink when a slot goes unused. A
 * single program sized for the largest transfer anyone might make charges
 * every ordinary transfer for slots it does not touch. The canonical transfer
 * -- verifier, one regulated input, one fee input; verifier, payment, change,
 * fee -- costs a third of what the widest shape costs, and picking the leaf
 * that fits is free.
 *
 * Spent at input 0 of every ordinary transfer of the regulated asset A.
 * Confinement induction: every A output must pay a user covenant C_U(Y), and
 * every A input independently requires (via the U program committed in it)
 * that input 0 carries the verifier asset AND that the verifier is recreated,
 * which is exactly what check 2 below enforces.
 *
 * Checks (design doc section 2.2 + 2.3):
 *   1. current input index == 0, carrying explicit asset V in amount exactly Q
 *   2. output 0 recreates the verifier: asset V, amount Q, same script as the
 *      current input
 *   3. the SENDER is proven once: a witness-supplied key, its committed height
 *      windows and one dmt-v1 membership proof against WL_ROOT. Removing that
 *      key from the whitelist is the FREEZE, and the lockup bound binds here.
 *   4. num_inputs <= N_max_inputs; every input carrying A must
 *      - carry an EXPLICIT asset id,
 *      - have script pubkey exactly C_U(sender) -- which is what makes "all
 *        regulated inputs share one owner" structural rather than checked,
 *      - and not be blacklisted, proven by exhibiting the dmt-v1 interval leaf
 *        that strictly contains SHA256(txid || BE32(vout)).
 *      At least one input must carry A, so only a holder advances the verifier.
 *   5. num_outputs <= N_max_outputs; every output that exists must carry an
 *      explicit asset id, and every output carrying A must either
 *      - pay C_U(sender), in which case it is CHANGE: it needs no proof, no
 *        receive window and no explicit value, because the sender's standing
 *        was already established in check 3 and retaining your own coins is
 *        not an acquisition; or
 *      - pay C_U(Y) for a witness-supplied recipient key Y, which must carry a
 *        whitelist membership proof, must have an open receive window, and
 *        must expose an explicit value that counts against the transfer limit.
 *      A fee output has an empty script pubkey, whose hash can never equal a
 *      P2TR script's, so "a fee output must not carry A" needs no separate
 *      check. Fee outputs in other assets pass, which the any-asset fee market
 *      requires.
 *   6. the sum of payments to owners other than the sender is at most LIMIT.
 *
 * There is no budget padding. Under Sequentia's Simplicity budget rule a
 * witness byte buys four weight units of execution
 * (SIMPLICITY_BUDGET_PER_WITNESS_BYTE, src/script/script.h in the node), which
 * every shape's functional witness covers with room to spare. On a chain still
 * running the one-to-one rule these programs are unspendable, which is the
 * correct failure: they would otherwise need tens of kilobytes of inert bytes
 * in every transfer.
 *
 * Compile-time parameters:
 *   ASSET_A  - u256 asset id of A (internal byte order)
 *   ASSET_V  - u256 asset id of V (internal byte order)
 *   AMOUNT_Q - u64 verifier amount in atoms
 *   U_CMR    - u256 CMR of the user program U for this asset
 *   WL_ROOT  - u256 dmt-v1 root of the owner/recipient whitelist (policy pi)
 *   BL_ROOT  - u256 dmt-v1 root of the outpoint blacklist, over INTERVAL leaves
 *   LIMIT    - u64 maximum total payable to OTHER owners in one transfer;
 *              0xffffffffffffffff means no limit
 *   PI       - u256 policy commitment. Inert: the covenant enforces the roots
 *              and the limit directly, and pi is a hash of them together with
 *              the policy SEQUENCE NUMBER. Committing it makes the statement
 *              the design document actually makes -- that C_V(pi) commits to
 *              one policy VERSION -- true, rather than only committing to one
 *              rule set, under which a rollback to an earlier snapshot with
 *              identical rules would reuse the same address.
 */

fn tap_data_hash(x: u256) -> u256 {
    let ctx: Ctx8 = jet::tapdata_init();
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, x);
    jet::sha_256_ctx_8_finalize(ctx)
}

fn spk_hash_of_key(output_key: Pubkey) -> u256 {
    let ctx: Ctx8 = jet::sha_256_ctx_8_init();
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_2(ctx, 0x5120);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, output_key);
    jet::sha_256_ctx_8_finalize(ctx)
}

/* SHA256 of the script pubkey of C_U(owner). */
fn cu_spk_hash(owner: Pubkey) -> u256 {
    let leaf: u256 = jet::build_tapleaf_simplicity(param::U_CMR);
    let root: u256 = jet::build_tapbranch(leaf, tap_data_hash(owner));
    let nums: Pubkey = 0x50929b74c1a04954b78b4b6035e97a5e078a5a0f28ec96d547bfee9ace803ac0;
    let out_key: Pubkey = jet::build_taptweak(nums, root);
    spk_hash_of_key(out_key)
}

/* dmt-v1 whitelist leaf:
 *     SHA256(0x00 || key || BE32(send_after) || BE32(recv_after))
 *
 * The height windows live in the LEAF rather than in a tree of their own, so the
 * single membership fold that proves a key approved also proves which windows
 * bind it. A witness cannot claim a bound the issuer never committed to, and the
 * windows cost no extra Merkle work at all - only the two extra words hashed
 * here and one lock jet at the point of use.
 *
 * Domain 0x00 is for real keys only. The tree's structural guards hash under
 * 0x03 (SPEC-dmt-v1.md section 3), so no guard slot can ever be exhibited here
 * as an approved key. */
fn wl_leaf(key: Pubkey, send_after: u32, recv_after: u32) -> u256 {
    let ctx: Ctx8 = jet::sha_256_ctx_8_init();
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_1(ctx, 0x00);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, key);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, send_after);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, recv_after);
    jet::sha_256_ctx_8_finalize(ctx)
}

/* dmt-v1 node: SHA256(0x01 || left || right); the bool says whether the
 * running node is the RIGHT child at this level. */
fn wl_step(elt: (u256, bool), node: u256) -> u256 {
    let (sib, node_is_right): (u256, bool) = elt;
    let ctx: Ctx8 = jet::sha_256_ctx_8_init();
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_1(ctx, 0x01);
    let ctx: Ctx8 = match node_is_right {
        true => {
            let c: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, sib);
            jet::sha_256_ctx_8_add_32(c, node)
        },
        false => {
            let c: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, node);
            jet::sha_256_ctx_8_add_32(c, sib)
        },
    };
    jet::sha_256_ctx_8_finalize(ctx)
}

fn require_wl_member(key: Pubkey, send_after: u32, recv_after: u32, proof: [(u256, bool); %%DEPTH%%]) {
    let root: u256 = array_fold::<wl_step, %%DEPTH%%>(proof, wl_leaf(key, send_after, recv_after));
    assert!(jet::eq_256(root, param::WL_ROOT));
}

/* Height windows (design doc 3.5).
 *
 * `check_lock_height(h)` succeeds exactly when h <= lockHeight(tx), where
 * lockHeight is the transaction's nLockTime if it is a height AND the
 * transaction is non-final, and 0 otherwise. That single jet therefore carries
 * the whole reduction: a covenant cannot read the chain height, but it can
 * require the spender to commit to one through a locktime consensus itself
 * enforces. A final transaction (every sequence 0xffffffff) has lockHeight 0, so
 * it can only satisfy a bound of 0 - the transaction cannot lie about its
 * height by simply ignoring nLockTime.
 *
 * A bound of 0 means unrestricted and is free: 0 <= anything holds. */
fn require_height_bound(bound: u32) {
    jet::check_lock_height(bound);
}

fn require_explicit_asset_eq(a: Asset1, expected: u256) {
    match a {
        Left(conf: (u1, u256)) => panic!(),
        Right(id: ExplicitAsset) => assert!(jet::eq_256(id, expected)),
    }
}

fn require_explicit_amount_eq(v: Amount1, expected: u64) {
    match v {
        Left(conf: (u1, u256)) => panic!(),
        Right(x: u64) => assert!(jet::eq_64(x, expected)),
    }
}

/* A payment to another owner must expose its value, or the limit could be
 * evaded by hiding the amount behind a commitment. Change is never routed
 * here, so blinded change stays permitted. */
fn explicit_value(v: Amount1) -> u64 {
    match v {
        Left(conf: (u1, u256)) => panic!(),
        Right(x: u64) => x,
    }
}

fn either(a: bool, b: bool) -> bool {
    match a {
        true => true,
        false => b,
    }
}

/* Scan one output slot. Returns what it contributes to the transfer limit.
 *
 * `cu_sender` is SHA256 of the sender's own C_U script pubkey, already computed
 * once for the input scan. An A output paying it is CHANGE, and change is
 * exempt from three things it used to be subjected to: the membership fold (the
 * sender's standing was proven in check 3 and is the same fact), the receive
 * window (a receive window restricts ACQUISITION; applying it to your own change
 * turns it into a spend prohibition, so a holder inside a Reg S window could not
 * transact at all unless a UTXO happened to equal the payment exactly), and the
 * explicit-value requirement (blinded change is deliberately permitted). */
fn check_output(i: u32, cu_sender: u256, w: Option<(Pubkey, u32, u32, [(u256, bool); %%DEPTH%%])>) -> u64 {
    match jet::output_amount(i) {
        None => 0, // beyond num_outputs; nothing to check
        Some(av: (Asset1, Amount1)) => {
            let (a, v): (Asset1, Amount1) = av;
            match a {
                Left(conf: (u1, u256)) => panic!(), // asset ids must be explicit
                Right(id: ExplicitAsset) => match jet::eq_256(id, param::ASSET_A) {
                    false => 0,
                    true => {
                        let spk: u256 = unwrap(jet::output_script_hash(i));
                        match jet::eq_256(spk, cu_sender) {
                            true => 0, // change
                            false => {
                                let (y, send_after, recv_after, proof): (Pubkey, u32, u32, [(u256, bool); %%DEPTH%%]) = unwrap(w);
                                assert!(jet::eq_256(cu_spk_hash(y), spk));
                                require_wl_member(y, send_after, recv_after, proof);
                                // The RECEIVE window (the Reg S pattern): this
                                // holder cannot be paid before their height.
                                require_height_bound(recv_after);
                                explicit_value(v)
                            },
                        }
                    },
                },
            }
        },
    }
}

/* Running total of payments to owners other than the sender, rejecting the
 * overflow that would otherwise wrap a large sum under the limit. */
fn add_payment(acc: u64, x: u64) -> u64 {
    let (carry, sum): (bool, u64) = jet::add_64(acc, x);
    match carry {
        true => panic!(),
        false => sum,
    }
}

/* Lexicographic "less than" on 256-bit values.
 *
 * There is no lt_256 jet (comparison jets stop at 64 bits), so it is built from
 * four 64-bit limbs, most significant first. Comparing only a prefix would be
 * cheaper and would also be a hole: an attacker could search for a blacklist
 * interval agreeing with the target key on the compared prefix. The full width
 * is compared.
 */
fn lt_pair_64(a_hi: u64, a_lo: u64, b_hi: u64, b_lo: u64) -> bool {
    match jet::lt_64(a_hi, b_hi) {
        true => true,
        false => match jet::eq_64(a_hi, b_hi) {
            true => jet::lt_64(a_lo, b_lo),
            false => false,
        },
    }
}

fn lt_128(a: u128, b: u128) -> bool {
    let (a_hi, a_lo): (u64, u64) = <u128>::into(a);
    let (b_hi, b_lo): (u64, u64) = <u128>::into(b);
    lt_pair_64(a_hi, a_lo, b_hi, b_lo)
}

fn eq_128(a: u128, b: u128) -> bool {
    let (a_hi, a_lo): (u64, u64) = <u128>::into(a);
    let (b_hi, b_lo): (u64, u64) = <u128>::into(b);
    match jet::eq_64(a_hi, b_hi) {
        true => jet::eq_64(a_lo, b_lo),
        false => false,
    }
}

fn lt_256(a: u256, b: u256) -> bool {
    let (a_hi, a_lo): (u128, u128) = <u256>::into(a);
    let (b_hi, b_lo): (u128, u128) = <u256>::into(b);
    match lt_128(a_hi, b_hi) {
        true => true,
        false => match eq_128(a_hi, b_hi) {
            true => lt_128(a_lo, b_lo),
            false => false,
        },
    }
}

/* dmt-v1 INTERVAL leaf: SHA256(0x02 || lo || hi).
 *
 * The blacklist tree stores gaps, not keys. Listing k_1 < ... < k_n produces the
 * n+1 intervals (GUARD_LO, k_1), (k_1, k_2), ..., (k_n, GUARD_HI), and proving
 * an outpoint absent means exhibiting the one interval that strictly contains
 * it. That is a single membership proof with no slot arithmetic - the adjacency
 * an outpoint-keyed non-membership proof needs is carried inside the leaf
 * instead of being reconstructed from proof indices, for which the dense tree
 * offers no cheap handle. A listed key is an interval ENDPOINT and the
 * comparisons below are strict, so no interval can cover it.
 */
fn bl_interval_leaf(lo: u256, hi: u256) -> u256 {
    let ctx: Ctx8 = jet::sha_256_ctx_8_init();
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_1(ctx, 0x02);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, lo);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, hi);
    jet::sha_256_ctx_8_finalize(ctx)
}

/* The blacklist policy key of an input's outpoint: SHA256(txid || BE32(vout)).
 * `input_prev_outpoint` yields the txid in internal byte order, and
 * sha_256_ctx_8_add_4 writes the index big-endian, which is the spec's BE32. */
fn outpoint_key(i: u32) -> u256 {
    let (txid, vout): (u256, u32) = unwrap(jet::input_prev_outpoint(i));
    let ctx: Ctx8 = jet::sha_256_ctx_8_init();
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, txid);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, vout);
    jet::sha_256_ctx_8_finalize(ctx)
}

/* Require that input i's outpoint is NOT blacklisted. */
fn require_bl_nonmember(i: u32, lo: u256, hi: u256, proof: [(u256, bool); %%DEPTH%%]) {
    let k: u256 = outpoint_key(i);
    assert!(lt_256(lo, k));
    assert!(lt_256(k, hi));
    let root: u256 = array_fold::<wl_step, %%DEPTH%%>(proof, bl_interval_leaf(lo, hi));
    assert!(jet::eq_256(root, param::BL_ROOT));
}

/* Scan one input slot. Returns whether the input carried asset A, which also
 * serves the "at least one regulated input" check.
 *
 * The owner is not re-derived per input. All regulated inputs of a transfer
 * belong to one sender -- the transfer limit needs that twice over, since a
 * limit is per sender and change is identified relative to one -- so the
 * covenant proves the sender ONCE and then requires each A input's script to be
 * exactly C_U(sender). That is the same binding the per-input construction gave
 * (a script equality against a proven key), it makes the single-sender rule
 * structural instead of a separate assertion, and it removes a 16-level Merkle
 * fold and a taproot reconstruction from every input slot after the first. */
fn check_input(i: u32, cu_sender: u256, w: Option<(u256, u256, [(u256, bool); %%DEPTH%%])>) -> bool {
    match jet::input_asset(i) {
        None => false, // beyond num_inputs; nothing to check
        Some(a: Asset1) => match a {
            // Asset ids must be explicit on every scanned input, not only on
            // outputs. Skipping a blinded input would leave a hole exactly the
            // size of the freeze: a coin of A behind an asset commitment would
            // pass unchecked. The confinement induction already forbids such a
            // UTXO existing, but relying on that here would make the freeze
            // depend on an argument rather than on a check.
            Left(conf: (u1, u256)) => panic!(),
            Right(id: ExplicitAsset) => match jet::eq_256(id, param::ASSET_A) {
                false => false,
                true => {
                    let (bl_lo, bl_hi, bl_proof): (u256, u256, [(u256, bool); %%DEPTH%%]) = unwrap(w);
                    // This input belongs to the sender proven in check 3...
                    assert!(jet::eq_256(cu_sender, unwrap(jet::input_script_hash(i))));
                    // ...and this particular outpoint is not frozen individually.
                    require_bl_nonmember(i, bl_lo, bl_hi, bl_proof);
                    true
                },
            },
        },
    }
}

fn main() {
    // 0. pi enters the program DAG, and therefore the CMR and the address, so
    // that a policy version is distinguishable on chain from a different
    // version with identical rules. eq_256(x, x) is always true; the point is
    // the commitment, not the comparison.
    assert!(jet::eq_256(param::PI, param::PI));

    // 1. own position and identity
    assert!(jet::eq_32(jet::current_index(), 0));
    let (ca, cv): (Asset1, Amount1) = jet::current_amount();
    require_explicit_asset_eq(ca, param::ASSET_V);
    require_explicit_amount_eq(cv, param::AMOUNT_Q);

    // 2. output 0 recreates the verifier under the same script. U checks this
    // same equality, which is what stops a stray q of V standing in for a
    // verifier covenant.
    let (a0, v0): (Asset1, Amount1) = unwrap(jet::output_amount(0));
    require_explicit_asset_eq(a0, param::ASSET_V);
    require_explicit_amount_eq(v0, param::AMOUNT_Q);
    assert!(jet::eq_256(unwrap(jet::output_script_hash(0)), jet::current_script_hash()));

    // 3. the sender, proven once. This is the freeze: a holder removed from the
    // whitelist can no longer satisfy the covenant for their own inputs, so
    // their balance stops moving.
    let (sender, s_send_after, s_recv_after, s_proof): (Pubkey, u32, u32, [(u256, bool); %%DEPTH%%]) = witness::SENDER;
    require_wl_member(sender, s_send_after, s_recv_after, s_proof);
    require_height_bound(s_send_after);
    let cu_sender: u256 = cu_spk_hash(sender);

    // 4. bounded OWNER scan. The bound is asserted, not assumed: without it an
    // extra regulated input would sit past the scan and spend unchecked.
    assert!(jet::lt_32(jet::num_inputs(), %%NUM_INPUTS_LT%%));
%%INPUT_SCAN%%
    // At least one regulated input: it is a C_U, which independently required
    // its owner's signature, so only holders can advance the verifier output.
    assert!(%%INPUT_ANY%%);

    // 5. bounded confinement scan. The bound is asserted, not assumed.
    assert!(jet::lt_32(jet::num_outputs(), %%NUM_OUTPUTS_LT%%));
%%OUTPUT_SCAN%%
    // 6. transfer limit (design doc 3.4): what leaves the sender's hands in this
    // transaction, to owners other than the sender, must not exceed the
    // committed limit. LIMIT is the u64 maximum when the issuer sets no limit,
    // which no sum of asset amounts can exceed.
    assert!(jet::le_64(paid, param::LIMIT));
}
